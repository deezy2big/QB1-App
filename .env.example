# Phase 1 runs the local image job on disk. The job runner does not
# call Adobe, AWS, PhotoShelter, Associated Press, or Okta, even if the
# flags below are set. Those accounts are later phases and must be ours.
#
# QB1 providers — local adapters run until these are filled in.
# Optional override for the on-disk job/inbox store (defaults to .data/)
# QB1_DATA_DIR=

# Orchestration
QB1_STORAGE=local          # local | s3
QB1_CUTOUT=local           # local | adobe
QB1_VISION=local           # local | rekognition
QB1_PHOTOSHELTER=local     # local | api
QB1_AP_IMAGES=local        # local | api
QB1_AUTH=local             # local | okta

# Okta (when QB1_AUTH=okta)
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# AWS (when QB1_STORAGE=s3 or QB1_VISION=rekognition)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
QB1_S3_BUCKET=

# Adobe Firefly / Photoshop cutout (when QB1_CUTOUT=adobe)
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_CUTOUT_URL=https://image.adobe.io/sensei/cutout

# Photo Shelter (when QB1_PHOTOSHELTER=api)
PHOTOSHELTER_API_KEY=
PHOTOSHELTER_API_SECRET=

# AP Images (when QB1_AP_IMAGES=api)
AP_IMAGES_API_KEY=
